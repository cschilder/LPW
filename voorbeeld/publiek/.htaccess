# Gepubliceerde bestanden (twtxt.txt, gemlog, phlog, blog) mogen gelezen worden
Options -Indexes
AddType text/plain .txt
AddType text/gemini .gmi
AddDefaultCharset utf-8
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
# Hier wordt alleen data gepubliceerd: nooit scripts uitvoeren
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
